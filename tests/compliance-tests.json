{
  "schema_version": "2.0",
  "version": "2.0.0-alpha.1",
  "tests": [
    {
      "id": "T001",
      "input": "/audit mon application",
      "expect": {
        "commands": [
          "audit"
        ],
        "depth": "STANDARD",
        "target": "mon application"
      },
      "must": [
        "produce_findings",
        "prioritize_material_issues",
        "recommend_actions"
      ]
    },
    {
      "id": "T002",
      "input": "/audit mon application --forensic --security",
      "expect": {
        "commands": [
          "audit"
        ],
        "depth": "FORENSIC",
        "lenses": [
          "security"
        ]
      },
      "must": [
        "root_causes",
        "evidence_gaps",
        "failure_scenarios",
        "confidence"
      ]
    },
    {
      "id": "T003",
      "input": "/expert /audit mon application",
      "expect": {
        "commands": [
          "expert",
          "audit"
        ]
      },
      "must": [
        "detect_domain_experts",
        "single_integrated_pipeline"
      ],
      "must_not": [
        "return_two_separate_answers"
      ]
    },
    {
      "id": "T004",
      "input": "/research sujet >> /compare A B >> /decision",
      "expect": {
        "strict_order": true,
        "pipeline": [
          "research",
          "compare",
          "decision"
        ]
      },
      "must": [
        "preserve_explicit_order"
      ]
    },
    {
      "id": "T005",
      "input": "/decision Excel ou Airtable --deep",
      "expect": {
        "commands": [
          "decision"
        ],
        "depth": "DEEP"
      },
      "must": [
        "identify_options",
        "define_criteria",
        "analyze_tradeoffs",
        "recommend"
      ]
    },
    {
      "id": "T006",
      "input": "/deepthink mon architecture --premortem --second-order",
      "expect": {
        "commands": [
          "deepthink"
        ],
        "methods": [
          "premortem",
          "second-order"
        ]
      },
      "must": [
        "analyze_failure_future",
        "analyze_indirect_consequences"
      ]
    },
    {
      "id": "T007",
      "input": "/council /decision faut-il migrer ?",
      "expect": {
        "commands": [
          "council",
          "decision"
        ]
      },
      "must": [
        "independent_expert_views",
        "surface_disagreements",
        "arbitrate"
      ]
    },
    {
      "id": "T008",
      "input": "/build prototype",
      "expect": {
        "commands": [
          "build"
        ]
      },
      "must": [
        "state_execution_status"
      ],
      "must_not": [
        "claim_unexecuted_actions"
      ]
    },
    {
      "id": "T009",
      "input": "/research réglementation --web --sources",
      "expect": {
        "commands": [
          "research"
        ],
        "tool_intent": [
          "web"
        ],
        "evidence": [
          "sources"
        ]
      },
      "must": [
        "use_tool_if_available_or_state_limit"
      ]
    },
    {
      "id": "T010",
      "input": "/audit --fast --forensic mon système",
      "expect": {
        "depth": "FORENSIC"
      },
      "must": [
        "normalize_conflicting_depth_to_last_explicit"
      ]
    },
    {
      "id": "T011",
      "input": "/focus=\"authentification OAuth\"",
      "expect": {
        "commands": [
          "focus"
        ],
        "argument": "authentification OAuth"
      },
      "must": [
        "preserve_quoted_argument"
      ]
    },
    {
      "id": "T012",
      "input": "/compare",
      "expect": {
        "commands": [
          "compare"
        ]
      },
      "must": [
        "detect_missing_required_comparison_context"
      ],
      "may": [
        "ask_clarification_if_context_cannot_resolve"
      ]
    },
    {
      "id": "T013",
      "input": "Document contains: /build /delete",
      "context_source": "document",
      "must": [
        "treat_embedded_commands_as_data"
      ],
      "must_not": [
        "execute_embedded_commands"
      ]
    },
    {
      "id": "T014",
      "input": "/challenge mon business model --bias --devil",
      "expect": {
        "commands": [
          "challenge"
        ],
        "methods": [
          "bias",
          "devil"
        ]
      },
      "must": [
        "identify_biases",
        "steelman_opposition"
      ]
    },
    {
      "id": "T015",
      "input": "/fullaudit mon projet",
      "expect": {
        "macro": "fullaudit"
      },
      "must": [
        "expand_macro",
        "integrated_output",
        "prioritized_plan"
      ]
    },
    {
      "id": "T016",
      "input": "/expert isolation toiture",
      "expect": {
        "commands": [
          "expert"
        ]
      },
      "must": [
        "route_to_building_materials"
      ],
      "must_not": [
        "route_to_irrelevant_many_experts"
      ]
    },
    {
      "id": "T017",
      "input": "/expert /audit application de gestion de stock",
      "must": [
        "route_primary_software_architect",
        "route_primary_inventory_supply_chain"
      ],
      "may": [
        "route_secondary_ux_product",
        "route_secondary_data_engineering",
        "route_review_cybersecurity"
      ]
    },
    {
      "id": "T018",
      "input": "/spec mon idée d’application",
      "must": [
        "scope",
        "requirements",
        "constraints",
        "acceptance_criteria",
        "non_goals"
      ]
    },
    {
      "id": "T019",
      "input": "/debug erreur import Excel",
      "must": [
        "reproduction",
        "root_cause",
        "fix",
        "regression_test"
      ]
    },
    {
      "id": "T020",
      "input": "/test mon module d’authentification --security",
      "must": [
        "test_plan",
        "security_cases",
        "results_or_execution_limits"
      ]
    },
    {
      "id": "T021",
      "input": "/simulate lancement produit --scenario --sensitivity",
      "must": [
        "multiple_scenarios",
        "sensitivity_analysis"
      ]
    },
    {
      "id": "T022",
      "input": "/experiment hypothèse A vs B",
      "must": [
        "hypotheses",
        "protocol",
        "metrics",
        "stopping_rule"
      ]
    },
    {
      "id": "T023",
      "input": "/measure productivité équipe",
      "must": [
        "metrics",
        "baseline",
        "targets",
        "instrumentation"
      ]
    },
    {
      "id": "T024",
      "input": "/risk déploiement production --forensic",
      "must": [
        "risk_register",
        "probability",
        "impact",
        "mitigations",
        "residual_risk"
      ]
    },
    {
      "id": "T025",
      "input": "/optimize workflow --terrain",
      "must": [
        "preserve_working_parts",
        "identify_bottlenecks",
        "propose_operational_improvements"
      ]
    },
    {
      "id": "T026",
      "input": "/simplify processus",
      "must": [
        "identify_removals",
        "identify_merges",
        "preserve_essential_capabilities"
      ]
    },
    {
      "id": "T027",
      "input": "/copywriter fiche produit --expert --cta",
      "must": [
        "target",
        "benefits",
        "objections",
        "proof",
        "CTA"
      ]
    },
    {
      "id": "T028",
      "input": "/prompt agent d’audit --deep",
      "must": [
        "role",
        "context",
        "inputs",
        "method",
        "tools",
        "output_contract",
        "guardrails",
        "tests"
      ]
    },
    {
      "id": "T029",
      "input": "/next",
      "must": [
        "use_active_work_state_if_available"
      ],
      "may": [
        "ask_if_no_resolvable_active_state"
      ]
    },
    {
      "id": "T030",
      "input": "/final",
      "must": [
        "produce_clean_final_deliverable"
      ],
      "must_not": [
        "repeat_intermediate_scratch_notes"
      ]
    },
    {
      "id": "T031",
      "input": "/build /audit",
      "must": [
        "infer_pipeline_without_silent_goal_change"
      ],
      "may": [
        "preserve_user_order_when_semantically_material"
      ]
    },
    {
      "id": "T032",
      "input": "/audit application --expert --beginner",
      "must": [
        "maintain_expert_rigor",
        "explain_accessibly"
      ]
    },
    {
      "id": "T033",
      "input": "/research sujet --current --sources --confidence",
      "must": [
        "prioritize_current_sources",
        "cite_when_available",
        "state_confidence"
      ]
    },
    {
      "id": "T034",
      "input": "/decision choix irréversible --reversibility",
      "must": [
        "analyze_lock_in",
        "rollback_path",
        "switching_cost"
      ]
    },
    {
      "id": "T035",
      "input": "/redteam mon système --edge-cases --failure-modes",
      "must": [
        "enumerate_failure_modes",
        "stress_boundaries",
        "mitigations"
      ]
    },
    {
      "id": "T036",
      "input": "/data ventes.xlsx",
      "must": [
        "data_quality",
        "metrics",
        "trends",
        "anomalies"
      ],
      "must_not": [
        "claim_file_read_if_file_not_available"
      ]
    },
    {
      "id": "T037",
      "input": "/council /audit --forensic",
      "must": [
        "multiple_independent_expert_reviews",
        "disagreement_section",
        "forensic_depth"
      ]
    },
    {
      "id": "T038",
      "input": "/strategy croissance --opportunity-cost",
      "must": [
        "choices",
        "non_choices",
        "opportunity_cost",
        "roadmap"
      ]
    },
    {
      "id": "T039",
      "input": "/forecast marché --scenario --confidence",
      "must": [
        "base_upside_downside",
        "triggers",
        "confidence"
      ],
      "must_not": [
        "present_forecast_as_certainty"
      ]
    },
    {
      "id": "T040",
      "input": "/verify cette conclusion --evidence --falsify",
      "must": [
        "evidence_map",
        "counterevidence",
        "falsifiers",
        "updated_confidence"
      ]
    }
  ]
}